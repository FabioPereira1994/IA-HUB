PORT=3000
NODE_ENV=development

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ai_customer_hub

# Troque por um valor longo e aleatório em produção
# (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# ---- Sprint 2: WhatsApp + IA ----

# Usada pra gerar embeddings da busca na base de conhecimento (Módulo 6)
OPENAI_API_KEY=sk-...

# URL base do seu servidor Evolution API (self-hosted)
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com

# Valor que você configura no cabeçalho customizado do webhook do Evolution
# API, pra garantir que só ele (e não qualquer um) chame /api/webhooks/whatsapp
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo

# URL do webhook do workflow "decisao-atendimento" no seu n8n
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/decisao-atendimento

# Precisa ser o mesmo valor configurado no node "Verificar Segredo" do workflow
N8N_WEBHOOK_SECRET=troque-por-outro-segredo
